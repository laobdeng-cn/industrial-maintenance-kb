APP_NAME=Industrial Maintenance KB
APP_ENV=development

POSTGRES_DB=maintenance_kb
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://maintenance:change_me@postgres:5432/maintenance_kb

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=maintenance_blocks_v1

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_CACHE_DIR=/data/models/fastembed

STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=104857600
